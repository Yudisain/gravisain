{
  "name": "gravisain-theme",
  "version": "1.0.2",
  "undagitalVersion": "0.5.1",
  "description": "Gravisain Premium WordPress Theme",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build:meta": "wp-scripts build src/meta/index.js --output-path=assets/meta",
    "build": "vite build && npm run build:meta",
    "theme:zip": "powershell -ExecutionPolicy Bypass -File scripts/zip-theme.ps1 -Channel both",
    "zip:wporg": "powershell -ExecutionPolicy Bypass -File scripts/zip-theme.ps1 -Channel wporg",
    "zip:undagital": "powershell -ExecutionPolicy Bypass -File scripts/zip-theme.ps1 -Channel undagital",
    "blocks:zip": "powershell -ExecutionPolicy Bypass -File ../gravisain-blocks/scripts/zip-plugin.ps1 -Channel both",
    "studio:zip": "powershell -ExecutionPolicy Bypass -File ../gravisain-studio/scripts/zip-plugin.ps1",
    "news:zip": "powershell -ExecutionPolicy Bypass -File ../gravinews/scripts/zip-plugin.ps1",
    "all:zip": "npm run theme:zip && npm run blocks:zip && npm run studio:zip && npm run news:zip",
    "set-version": "node scripts/set-version.js",
    "set-version:undagital": "node scripts/set-version.js --undagital",
    "bump": "node scripts/set-version.js"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "@wordpress/scripts": "^27.9.0",
    "autoprefixer": "^10.4.19",
    "bestzip": "^3.0.1",
    "postcss": "^8.4.38",
    "postcss-nested": "^6.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite": "^5.2.11",
    "vite-plugin-static-copy": "^1.0.6"
  },
  "dependencies": {
    "react-color": "^2.19.3"
  }
}
