{
  "name": "gravisain-theme",
  "version": "1.0.0",
  "description": "Gravisain Premium WordPress Theme",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:meta": "wp-scripts build src/meta/index.js --output-path=assets/meta",
    "build": "vite build && npm run build:meta",
    "theme:zip": "npm run build && powershell -ExecutionPolicy Bypass -File scripts/zip-theme.ps1",
    "starter-sites:zip": "powershell -ExecutionPolicy Bypass -File ../gravisain-starter-sites/scripts/zip-starter-sites.ps1",
    "blocks:zip": "powershell -ExecutionPolicy Bypass -File ../gravisain-blocks/scripts/zip-plugin.ps1",
    "studio:zip": "powershell -ExecutionPolicy Bypass -File ../gravisain-studio/scripts/zip-plugin.ps1",
    "all:zip": "npm run theme:zip && npm run starter-sites:zip && npm run blocks:zip && npm run studio:zip"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "@wordpress/scripts": "^27.9.0",
    "autoprefixer": "^10.4.19",
    "bestzip": "^3.0.1",
    "exceljs": "^4.4.0",
    "postcss": "^8.4.38",
    "postcss-nested": "^6.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite": "^5.2.11"
  },
  "dependencies": {
    "react-color": "^2.19.3"
  }
}
